// The tailnet policy file: who may reach what (docs/tailscale-policy.md, docs/network.md).
// hanok's own part. My projects bring theirs (`.hanok/tailnet.hujson` in their repository, ADR 0007):
// tailscale/combine.py checks them and adds them, then .github/workflows/tailscale-policy.yml tests (pull requests)
// or applies (main, hourly) the result. Edit it here, never in the admin console: the next run overwrites it.
{
	// Labels for machines that belong to the tailnet, not to a person. `[]`: only the tailnet's admins may give them.
	"tagOwners": {
		"tag:grafana":       [],
		"tag:obsidian":      [], // the Obsidian LiveSync sidecar (ADR 0006)
		"tag:nas":           [],
		"tag:exit-node":     [],
		"tag:subnet-router": [],
		// A household's services, on 443 (ADR 0008). Given next to a service's own tag, e.g. a project's sidecar
		// (tag:family-media-seerr,tag:family): the project decides which of its services a household gets.
		"tag:family": [], // the family site's household
		"tag:home":   [], // my household
	},

	// Names for tests only, so they read as machines instead of addresses.
	"hosts": {
		"macnook-pro": "100.99.84.107",
		"family-dsm":  "100.126.142.105",
	},

	// A site's range is approved when its gateway advertises it; any exit node is, once tagged.
	"autoApprovers": {
		"routes": {
			"192.168.77.0/24": ["tag:subnet-router"], // family
			"192.168.93.0/24": ["tag:subnet-router"], // home
		},
		"exitNode": ["tag:exit-node"],
	},

	"grants": [
		// 1. Me (the owner, and any admin): every device of mine reaches everything, and may use any exit node.
		{
			"src": ["autogroup:owner", "autogroup:admin"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:owner", "autogroup:admin"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},

		// People invited into the tailnet belong to households (ADR 0008): group:family (the family site) and group:home
		// (mine). Who is in which comes from the TAILNET_GROUPS secret, added by combine.py: no email in this file. A member
		// in no group reaches nothing.

		// 2. The family household: their NAS, and the internet through a tagged exit node (theirs).
		{
			"src": ["group:family"],
			"dst": ["tag:nas"],
			"ip":  ["tcp:443", "tcp:445"],
		},
		{
			"src": ["group:family"],
			"dst": ["family-dsm"],
			"ip":  ["tcp:5000", "tcp:5001", "tcp:6690", "tcp:445", "tcp:8443"],
		},
		{
			"src": ["group:family"],
			"dst": ["autogroup:internet"],
			"via": ["tag:exit-node"],
			"ip":  ["*"],
		},

		// 3. Household services. The family's (media, requests) are open to my household too; mine only to mine.
		// Files and exit nodes stay with their own household.
		{
			"src": ["group:family", "group:home"],
			"dst": ["tag:family"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["group:home"],
			"dst": ["tag:home"],
			"ip":  ["tcp:443"],
		},

		// 4. Family, the old way: shared machines (autogroup:shared). Kept until every family member is invited and the
		// shares are removed (docs/runbooks/family-members.md), then deleted.
		{
			"src": ["autogroup:shared"],
			"dst": ["family-dsm"],
			"ip":  ["tcp:5000", "tcp:5001", "tcp:6690", "tcp:445", "tcp:8443"],
		},
		{
			"src": ["autogroup:shared"],
			"dst": ["tag:nas"],
			"ip":  ["tcp:443", "tcp:445"],
		},
		{
			"src": ["autogroup:shared"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	"tests": [
		{
			"src":    "macnook-pro",
			"accept": ["1.1.1.1:443", "family-dsm:5000", "tag:obsidian:443", "tag:family:443"],
		},
		{
			"src":    "group:family",
			"accept": ["tag:nas:445", "family-dsm:5000", "tag:family:443"],
			"deny":   ["tag:home:443", "tag:grafana:443", "tag:obsidian:443", "macnook-pro:22"],
		},
		{
			"src":    "group:home",
			"accept": ["tag:family:443", "tag:home:443"],
			"deny": [
				"tag:nas:445",
				"family-dsm:5000",
				"tag:grafana:443",
				"tag:obsidian:443",
				"macnook-pro:22",
			],
		},
	],
}
