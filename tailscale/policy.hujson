// The tailnet policy file: who may reach what (docs/tailscale-policy.md, docs/network.md).
// hanok's own part. My projects bring theirs (`.hanok/tailnet.hujson` in their repository, ADR 0007):
// tailscale/combine.py checks them and adds them, then .github/workflows/tailscale-policy.yml tests (pull requests)
// or applies (main, hourly) the result. Edit it here, never in the admin console: the next run overwrites it.
{
	// Labels for machines that belong to the tailnet, not to a person. `[]`: only the tailnet's admins may give them.
	"tagOwners": {
		"tag:grafana":       [],
		"tag:obsidian":      [], // the Obsidian LiveSync sidecar (ADR 0006)
		"tag:nas":           [],
		"tag:exit-node":     [],
		"tag:subnet-router": [],
		// A service my family may open, on 443 (ADR 0008). Given next to its own tag, e.g. a project's sidecar
		// (tag:family-media-seerr,tag:family): the project decides which of its services are for the family.
		"tag:family":        [],
	},

	// Names for tests only, so they read as machines instead of addresses.
	"hosts": {
		"macnook-pro": "100.99.84.107",
		"family-dsm":  "100.126.142.105",
	},

	// A site's range is approved when its gateway advertises it; any exit node is, once tagged.
	"autoApprovers": {
		"routes": {
			"192.168.77.0/24": ["tag:subnet-router"], // family
			"192.168.93.0/24": ["tag:subnet-router"], // home
		},
		"exitNode": ["tag:exit-node"],
	},

	"grants": [
		// 1. Me (the owner, and any admin): every device of mine reaches everything, and may use any exit node.
		{"src": ["autogroup:owner", "autogroup:admin"], "dst": ["*"], "ip": ["*"]},
		{
			"src": ["autogroup:owner", "autogroup:admin"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},

		// 2. Family, invited into the tailnet as members (ADR 0008): their NAS, the services tagged tag:family, and the
		// internet through a tagged exit node. Nothing else: no other machine, no LAN route, no SSH to my servers.
		{
			"src": ["autogroup:member"],
			"dst": ["tag:nas"],
			"ip":  ["tcp:443", "tcp:445"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["family-dsm"],
			"ip":  ["tcp:5000", "tcp:5001", "tcp:6690", "tcp:445", "tcp:8443"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:family"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:internet"],
			"via": ["tag:exit-node"],
			"ip":  ["*"],
		},

		// 3. Family, the old way: shared machines (autogroup:shared). Kept until every family member is invited and the
		// shares are removed (docs/runbooks/family-members.md), then deleted.
		{
			"src": ["autogroup:shared"],
			"dst": ["family-dsm"],
			"ip":  ["tcp:5000", "tcp:5001", "tcp:6690", "tcp:445", "tcp:8443"],
		},
		{
			"src": ["autogroup:shared"],
			"dst": ["tag:nas"],
			"ip":  ["tcp:443", "tcp:445"],
		},
		{
			"src": ["autogroup:shared"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	"tests": [
		{
			"src":    "macnook-pro",
			"accept": ["1.1.1.1:443", "family-dsm:5000", "tag:obsidian:443"],
		},
	],
}
