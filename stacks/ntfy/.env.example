# Every key stacks/ntfy reads; the values live in secrets.enc.env (sops stacks/ntfy/secrets.enc.env).
#
# Users, comma-separated <name>:<bcrypt hash>:<admin|user>. Hash a password with:
#   docker run --rm -it binwiederhier/ntfy:v2.36.0 user hash
# Wrap the whole value in single quotes: Compose expands `$` in --env-file values, and a bcrypt hash is full of
# them. SOPS keeps the quotes. e.g. NTFY_AUTH_USERS='me:$2a$10$...:user,family-media:$2a$10$...:user'
NTFY_AUTH_USERS=
# Topic permissions, comma-separated <user>:<topic or pattern>:<rw|ro|wo>.
NTFY_AUTH_ACCESS=
# Tokens for services that publish, comma-separated <user>:<tk_ + 29 chars>[:<label>]. Generate one with:
#   docker run --rm binwiederhier/ntfy:v2.36.0 token generate
NTFY_AUTH_TOKENS=
