# Every key stacks/obsidian-livesync reads. Values go in secrets.enc.env (sops stacks/obsidian-livesync/secrets.enc.env).
# Passwords: letters and digits only (couchdb/init.sh puts them into JSON as is): openssl rand -hex 24
#
# The vault's end-to-end encryption passphrase is NOT here: the server never needs it. It lives in my password
# manager, in each device's LiveSync settings, and in the agents' headless client.

# CouchDB's server admin: maintenance, and rebuilding the remote from a device (docs/runbooks/obsidian-livesync.md).
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=
# My Obsidian apps (Mac, phone): admin of the vault database only.
DEVICES_USER=devices
DEVICES_PASSWORD=
# The agents' headless LiveSync client: member of the vault database (documents only).
AGENTS_USER=agents
AGENTS_PASSWORD=
# The CouchDB database holding the vault.
VAULT_DATABASE=vault
# Profile `tailnet` only: a single-use auth key tagged tag:obsidian (Tailscale admin console > Settings > Keys).
# Only read at the first login (TS_AUTH_ONCE); it can be removed afterwards.
TS_AUTHKEY_OBSIDIAN=
