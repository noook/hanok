# Every key stacks/observability reads. Values go in secrets.enc.env (sops stacks/observability/secrets.enc.env).
# For a migration from Plouf, the admin password already stored in Plouf's Grafana data wins: Grafana only uses
# this one when it creates its database.
GRAFANA_ADMIN_PASSWORD=
# Optional: the address Grafana puts in links (alerts, shares). https://grafana.<tailnet>.ts.net
GRAFANA_ROOT_URL=
# Optional: alerts to Telegram (the same bot as the other homelab notifications).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Profile `tailnet` only: an auth key tagged tag:grafana (Tailscale admin console > Settings > Keys).
TS_AUTHKEY_GRAFANA=
# Optional overrides
GRAFANA_PORT=3317
PLOUF_MONITORING_DIR=/opt/stacks/plouf/monitoring/grafana
